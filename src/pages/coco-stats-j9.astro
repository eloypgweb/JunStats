---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import getSupabaseServer from '../lib/db/supabase-server';
import '../styles/global.css';

const supabase = getSupabaseServer();

// Obtener las estadísticas del partido 43 (J9)
const { data: stats, error } = await supabase
  .from('player_stats')
  .select(`
    *,
    players!inner (
      nombre,
      apellido,
      dorsal
    ),
    games (
      opponent,
      date,
      result
    )
  `)
  .eq('game_id', 43)
  .order('players(dorsal)', { ascending: true });

if (error) {
  console.error('Error fetching stats:', error);
}

// Obtener información del partido
const gameInfo = stats && stats.length > 0 ? stats[0].games : null;

// Encontrar el MVP (mayor valoración)
const mvpPlayer = stats?.reduce((max, player) => 
  (player.valuation ?? 0) > (max.valuation ?? 0) ? player : max
, stats[0]);

// Función para formatear minutos a MM:SS
function formatMinutes(totalSeconds: number | null): string {
  if (totalSeconds === null || totalSeconds === 0) return '00:00';
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
}
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Estadísticas Jornada 9 - JunStats" description="Estadísticas detalladas de la Jornada 9" />
    <style>
      body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
      }

      .stats-container {
        max-width: 100%;
        margin: 0 auto;
        padding: 2rem 0.5rem;
      }

      .content-wrapper {
        max-width: 1600px;
        margin: 0 auto;
      }

      .page-title {
        text-align: center;
        font-size: 3.5rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #ffd700 0%, #ffed4e 50%, #ffd700 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 3px;
        text-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
        animation: glow 2s ease-in-out infinite alternate;
      }

      @keyframes glow {
        from {
          filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.5));
        }
        to {
          filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.8));
        }
      }

      .match-info {
        text-align: center;
        margin-bottom: 2rem;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 1.5rem;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 2rem;
      }

      .match-opponent {
        text-align: right;
      }

      .match-date {
        text-align: left;
      }

      .match-opponent h2,
      .match-date p {
        margin: 0;
      }

      .match-info h2 {
        font-size: 1.8rem;
        color: #2d3748;
        font-weight: 700;
      }

      .match-info p {
        color: #718096;
        font-size: 1rem;
      }

      .match-result {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
      }

      .score-container {
        font-size: 2.5rem;
        font-weight: 900;
        display: flex;
        gap: 1rem;
        align-items: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 1rem 2rem;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
      }

      .team-score {
        min-width: 3rem;
        text-align: center;
        color: white;
        transition: transform 0.3s ease;
      }

      .team-score.winner {
        color: #ffd700;
        transform: scale(1.1);
        text-shadow: 0 0 20px rgba(255, 215, 0, 0.8);
      }

      .team-score.opponent {
        color: rgba(255, 255, 255, 0.7);
      }

      .score-separator {
        color: rgba(255, 255, 255, 0.5);
        font-weight: 300;
      }

      .result-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border-radius: 50px;
        font-weight: 700;
        font-size: 1.1rem;
        color: white;
        box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      .badge-icon {
        font-size: 1.5rem;
        animation: rotate 3s linear infinite;
      }

      @keyframes rotate {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      .table-container {
        overflow-x: auto;
        margin-top: 2rem;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
      }

      .stats-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: auto;
      }

      .stats-table th:nth-child(1),
      .stats-table td:nth-child(1) {
        width: 50px;
      }

      .stats-table th:nth-child(2),
      .stats-table td:nth-child(2) {
        width: auto;
        min-width: 140px;
      }

      .stats-table th:nth-child(n+3),
      .stats-table td:nth-child(n+3) {
        width: 60px;
      }

      .stats-table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
      }

      .stats-table th {
        padding: 1.25rem 0.4rem;
        text-align: center;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 3px solid #ffd700;
        white-space: nowrap;
      }

      .stats-table th:first-child {
        border-top-left-radius: 20px;
      }

      .stats-table th:last-child {
        border-top-right-radius: 20px;
      }

      .stats-table td {
        padding: 1rem 0.4rem;
        text-align: center;
        border-bottom: 1px solid #e2e8f0;
        color: #2d3748;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        white-space: nowrap;
      }

      .stats-table tbody tr {
        background-color: white;
        transition: all 0.3s ease;
      }

      .stats-table tbody tr:nth-child(even) {
        background-color: #f7fafc;
      }

      .stats-table tbody tr:hover {
        background: linear-gradient(90deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        transform: scale(1.01);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
      }

      .stats-table tbody tr:last-child td:first-child {
        border-bottom-left-radius: 20px;
      }

      .stats-table tbody tr:last-child td:last-child {
        border-bottom-right-radius: 20px;
      }

      .player-name {
        text-align: left;
        font-weight: 600;
        font-size: 0.9rem;
        color: #1a202c;
        padding-left: 0.8rem !important;
        padding-right: 0.8rem !important;
        min-width: 140px;
        max-width: 160px;
      }

      .mvp-crown {
        display: inline-block;
        margin-right: 0.5rem;
        font-size: 1.2rem;
        animation: bounce 1s ease-in-out infinite;
      }

      @keyframes bounce {
        0%, 100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-5px);
        }
      }

      .stat-highlight {
        font-weight: 700;
        font-size: 1.15rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      @media (max-width: 768px) {
        body {
          background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .stats-container {
          padding: 1.5rem 0.5rem;
        }

        .match-info {
          grid-template-columns: 1fr;
          gap: 1rem;
          padding: 1.5rem 1rem;
        }

        .match-opponent,
        .match-date {
          text-align: center;
        }

        .page-title {
          font-size: 2rem;
          letter-spacing: 2px;
        }

        .match-info {
          padding: 1.5rem 1rem;
          border-radius: 15px;
        }

        .match-info h2 {
          font-size: 1.5rem;
        }

        .match-info p {
          font-size: 1rem;
        }

        .score-container {
          font-size: 2rem;
          padding: 1rem 2rem;
          gap: 1rem;
        }

        .result-badge {
          padding: 0.75rem 1.5rem;
          font-size: 1.1rem;
        }

        .table-container {
          border-radius: 15px;
        }

        .stats-table th {
          padding: 1rem 0.5rem;
          font-size: 0.8rem;
        }

        .stats-table td {
          padding: 0.75rem 0.25rem;
          font-size: 0.85rem;
        }

        .player-name {
          font-size: 0.9rem;
          padding-left: 1rem !important;
        }

        .mvp-crown {
          font-size: 1.2rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="stats-container">
        <div class="content-wrapper">
        <h1 class="page-title">Estadísticas Jornada 9</h1>
        
        <div class="match-info">
          <div class="match-opponent">
            <h2>vs {gameInfo?.opponent || 'Repick Sanse'}</h2>
          </div>
          
          <div class="match-result">
            <div class="score-container">
              <span class="team-score opponent">35</span>
              <span class="score-separator">-</span>
              <span class="team-score winner">45</span>
            </div>
            <div class="result-badge">
              <span class="badge-icon">🏆</span>
              <span class="badge-text">Victoria</span>
            </div>
          </div>

          <div class="match-date">
            <p>📅 {gameInfo?.date ? new Date(gameInfo.date).toLocaleDateString('es-ES') : '25/11/2025'}</p>
          </div>
        </div>

        <div class="table-container">
          <table class="stats-table">
            <thead>
              <tr>
                <th>Nº</th>
                <th>Jugador</th>
                <th>Min</th>
                <th>Pts</th>
                <th>T2</th>
                <th>T3</th>
                <th>TL</th>
                <th>TL Int</th>
                <th>Asis</th>
                <th>Reb</th>
                <th>Rec</th>
                <th>Per</th>
                <th>Tap</th>
                <th>Fal</th>
                <th>Val</th>
              </tr>
            </thead>
            <tbody>
              {stats && stats.map((stat) => {
                const playerName = `${stat.players.nombre} ${stat.players.apellido}`;
                const isMVP = stat.player_id === mvpPlayer?.player_id;
                
                return (
                  <tr>
                    <td>{stat.players.dorsal}</td>
                    <td class="player-name">
                      {isMVP && <span class="mvp-crown">👑</span>}
                      {playerName}
                    </td>
                    <td>{formatMinutes(stat.minutes)}</td>
                    <td class="stat-highlight">{stat.points ?? 0}</td>
                    <td>{stat.t2_made ?? 0}</td>
                    <td>{stat.t3_made ?? 0}</td>
                    <td>{stat.ft_made ?? 0}</td>
                    <td>{stat.ft_att ?? 0}</td>
                    <td>{stat.assists ?? 0}</td>
                    <td>{stat.rebounds ?? 0}</td>
                    <td>{stat.steals ?? 0}</td>
                    <td>{stat.turnovers ?? 0}</td>
                    <td>{stat.blocks ?? 0}</td>
                    <td>{stat.fouls ?? 0}</td>
                    <td class="stat-highlight">{stat.valuation ?? 0}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {!stats || stats.length === 0 ? (
          <p style="text-align: center; margin-top: 2rem; color: var(--text-muted);">
            No hay estadísticas disponibles para esta jornada.
          </p>
        ) : null}
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
