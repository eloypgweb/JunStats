---
import JornadaPost from '../../layouts/JornadaPost.astro';
import '../../styles/jornadas-shared.css';
// i18n
import { getTranslations } from '../../i18n/translations';
const t = getTranslations('es').jornadas;

function formatMinutes(value: string | undefined): string {
  if (!value) return '00:00';
  const [minutes = '00', seconds = '00'] = value.split(':');
  return `${minutes.padStart(2, '0')}:${seconds.padStart(2, '0')}`;
}

const youtubeUrl = 'https://youtu.be/2dtL3DFEoK8';

const players = [
  { number: 1, name: 'Hugo Arias', minutes: '', points: 10, t2: 4, t3: 0, ft: '2/5', assists: 0, rebounds: 2, steals: 2, turnovers: 2, fouls: 1, rating: 14 },
  { number: 8, name: 'Sergio Redondo', minutes: '', points: 6, t2: 3, t3: 0, ft: '0/0', assists: 2, rebounds: 5, steals: 3, turnovers: 1, fouls: 0, rating: 15 },
  { number: 12, name: 'Pablo Fernández', minutes: '', points: 4, t2: 2, t3: 0, ft: '0/0', assists: 0, rebounds: 1, steals: 1, turnovers: 3, fouls: 0, rating: 5 },
  { number: 13, name: 'Tristán Redondo', isAbsent: true },
  { number: 15, name: 'Uyi', minutes: '', points: 7, t2: 2, t3: 1, ft: '0/0', assists: 0, rebounds: 7, steals: 1, turnovers: 1, fouls: 2, rating: 14 },
  { number: 16, name: 'David Ortega', minutes: '', points: 1, t2: 0, t3: 0, ft: '1/2', assists: 1, rebounds: 1, steals: 2, turnovers: 2, fouls: 5, rating: 1 },
  { number: 17, name: 'Álvaro Zamorano', minutes: '', points: 10, t2: 3, t3: 1, ft: '1/2', assists: 1, rebounds: 2, steals: 3, turnovers: 2, fouls: 2, rating: 16 },
  { number: 20, name: 'Daniel Chamizo', minutes: '', points: 6, t2: 3, t3: 0, ft: '0/0', assists: 0, rebounds: 7, steals: 1, turnovers: 0, fouls: 2, rating: 13 },
  { number: 30, name: 'Álvaro Fernández', minutes: '', points: 2, t2: 1, t3: 0, ft: '0/0', assists: 0, rebounds: 1, steals: 0, turnovers: 0, fouls: 3, rating: 0 },
  { number: 33, name: 'Roberto García', minutes: '', points: 3, t2: 1, t3: 0, ft: '1/2', assists: 1, rebounds: 1, steals: 0, turnovers: 2, fouls: 4, rating: 1 },
  { number: 56, name: 'Víctor Guardeño', minutes: '', points: 0, t2: 0, t3: 0, ft: '0/0', assists: 2, rebounds: 3, steals: 1, turnovers: 0, fouls: 0, rating: 7 },
  { number: 91, name: 'Rodrigo Díaz', minutes: '', points: 18, t2: 7, t3: 1, ft: '1/2', assists: 0, rebounds: 4, steals: 4, turnovers: 1, fouls: 2, rating: 23 }
];

const mvpNumber = 91;
---

<JornadaPost 
  title="Jornada 8"
  description="Resumen de la octava jornada de la temporada."
  pubDate={new Date('2025-11-15')}
>
  <div class="match-info">
    <h3><span data-i18n="vs">{t.vs}</span> Valcude Alcobendas</h3>

    <div class="match-result victory">
      <div class="score-container">
        <span class="team-score opponent">57</span>
        <span class="score-separator">-</span>
        <span class="team-score home winner">69</span>
      </div>

      <div class="result-badge">
        <span class="badge-icon">🏆</span>
        <span class="badge-text" data-i18n="victory">{t.victory}</span>
      </div>
    </div>
  </div>

  {youtubeUrl && (
    <div class="match-video">
      <a class="video-link" href={youtubeUrl} target="_blank" rel="noopener noreferrer">
        ▶ Ver partido en YouTube
      </a>
    </div>
  )}

  <div class="table-container">
    <table class="jornada-table">
      <thead>
        <tr>
          <th>{t.number}</th>
          <th>{t.player}</th>
          <th>{t.points}</th>
          <th>{t.t2}</th>
          <th>{t.t3}</th>
          <th>{t.freeThrows}</th>
          <th>{t.assists}</th>
          <th>{t.rebounds}</th>
          <th>{t.steals}</th>
          <th>{t.turnovers}</th>
          <th>{t.fouls}</th>
          <th>{t.rating}</th>
        </tr>
      </thead>

      <tbody>
        {players.map((player) =>
          player.isAbsent ? (
            <tr class="ausente-row">
              <td>{player.number}</td>
              <td>{player.name}</td>
              <td colspan="11" class="ausente-cell">
                <span class="ausente-badge">🕘 FALTA</span>
              </td>
            </tr>
          ) : (
            <tr>
              <td>{player.number}</td>
              <td>
                {player.number === mvpNumber && <span class="mvp-crown-table">👑</span>}
                {player.name}
              </td>
              <td>{player.points}</td>
              <td>{player.t2}</td>
              <td>{player.t3}</td>
              <td>{player.ft}</td>
              <td>{player.assists}</td>
              <td>{player.rebounds}</td>
              <td>{player.steals}</td>
              <td>{player.turnovers}</td>
              <td>{player.fouls}</td>
              <td>{player.rating}</td>
            </tr>
          )
        )}
      </tbody>
    </table>

    <div class="mobile-cards">
      {players.map((player) =>
        player.isAbsent ? (
          <div class="player-card ausente-card">
            <div class="player-name">
              {player.name} <span class="player-number">{player.number}</span>
            </div>
            <div class="stats-grid">
              <span class="ausente-badge">🕘 FALTA</span>
            </div>
          </div>
        ) : (
          <div class="player-card">
            <div class="player-name">
              {player.number === mvpNumber && <div class="mvp-crown-top">👑</div>}
              {player.name} <span class="player-number">{player.number}</span>
            </div>

            <div class="stats-grid">
              <div class="stat-item"><span>{t.pointsLabel}</span><span>{player.points}</span></div>
              <div class="stat-item"><span>{t.t2}</span><span>{player.t2}</span></div>
              <div class="stat-item"><span>{t.t3}</span><span>{player.t3}</span></div>
              <div class="stat-item"><span>{t.freeThrows}</span><span>{player.ft}</span></div>
              <div class="stat-item"><span>{t.assistsLabel}</span><span>{player.assists}</span></div>
              <div class="stat-item"><span>{t.reboundsLabel}</span><span>{player.rebounds}</span></div>
              <div class="stat-item"><span>{t.stealsLabel}</span><span>{player.steals}</span></div>
              <div class="stat-item"><span>{t.turnoversLabel}</span><span>{player.turnovers}</span></div>
              <div class="stat-item"><span>{t.foulsLabel}</span><span>{player.fouls}</span></div>
            </div>
          </div>
        )
      )}
    </div>
  </div>
</JornadaPost>

<script>
  import { initJornadaLanguageSync } from '../../scripts/jornadaLanguageSync';
  initJornadaLanguageSync();
</script>