---
import JornadaPost from '../../layouts/JornadaPost.astro';
import '../../styles/jornadas-shared.css';
// i18n
import { getTranslations } from '../../i18n/translations';
const t = getTranslations('es').jornadas;

const players = [
  { number: 1, name: 'Hugo Arias', minutes: '10:46', points: 0, t2: 0, t3: 0, ftMade: 0, ftAtt: 4, assists: 0, rebounds: 3, steals: 0, turnovers: 1, fouls: 1, valuation: -3 },
  { number: 8, name: 'Sergio Redondo', minutes: '08:38', points: 0, t2: 0, t3: 0, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 1, steals: 0, turnovers: 0, fouls: 0, valuation: -2 },
  { number: 12, name: 'Pablo Fernández', minutes: '22:11', points: 6, t2: 1, t3: 1, ftMade: 1, ftAtt: 5, assists: 1, rebounds: 4, steals: 1, turnovers: 2, fouls: 1, valuation: 5 },
  { number: 13, name: 'Tristán Redondo', minutes: '15:46', points: 0, t2: 0, t3: 0, ftMade: 0, ftAtt: 2, assists: 1, rebounds: 1, steals: 0, turnovers: 0, fouls: 1, valuation: -1 },
  { number: 15, name: 'Uyi', minutes: '17:36', points: 2, t2: 1, t3: 0, ftMade: 0, ftAtt: 2, assists: 0, rebounds: 3, steals: 4, turnovers: 5, fouls: 1, valuation: -2 },
  { number: 16, name: 'David Ortega', minutes: '11:07', points: 1, t2: 0, t3: 0, ftMade: 1, ftAtt: 2, assists: 0, rebounds: 0, steals: 1, turnovers: 0, fouls: 4, valuation: -3 },
  { number: 17, name: 'Álvaro Zamorano', minutes: '19:41', points: 9, t2: 3, t3: 1, ftMade: 0, ftAtt: 2, assists: 0, rebounds: 2, steals: 0, turnovers: 6, fouls: 3, valuation: 0 },
  { number: 20, name: 'Daniel Chamizo', minutes: '22:23', points: 9, t2: 4, t3: 0, ftMade: 1, ftAtt: 1, assists: 2, rebounds: 6, steals: 4, turnovers: 0, fouls: 1, valuation: 19 },
  { number: 30, name: 'Álvaro Fernández', minutes: '17:04', points: 10, t2: 3, t3: 1, ftMade: 1, ftAtt: 2, assists: 0, rebounds: 3, steals: 2, turnovers: 2, fouls: 0, valuation: 10 },
  { number: 33, name: 'Roberto García', minutes: '15:30', points: 0, t2: 0, t3: 0, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 1, steals: 0, turnovers: 3, fouls: 0, valuation: -3 },
  { number: 56, name: 'Víctor Guardeño', minutes: '15:14', points: 6, t2: 3, t3: 0, ftMade: 0, ftAtt: 3, assists: 0, rebounds: 2, steals: 2, turnovers: 3, fouls: 5, valuation: -1 },
  { number: 91, name: 'Rodrigo Díaz', minutes: '23:58', points: 11, t2: 4, t3: 0, ftMade: 3, ftAtt: 7, assists: 3, rebounds: 2, steals: 6, turnovers: 2, fouls: 2, valuation: 16 }
];

const mvpNumber = 20;

---

<JornadaPost 
  title="Jornada 22"
  description="Resumen de la jornada 22 de la temporada."
  pubDate={new Date('2026-04-12')}
>
  <div class="match-info">
    <h3><span data-i18n="vs">{t.vs}</span> Vicálvaro Baloncesto</h3>
    <div class="match-result victory">
      <div class="score-container">
        <span class="team-score opponent">46</span>
        <span class="score-separator">-</span>
        <span class="team-score home winner">54</span>
      </div>
      <div class="result-badge">
        <span class="badge-icon">🏆</span>
        <span class="badge-text" data-i18n="victory">{t.victory}</span>
      </div>
    </div>
  </div>

  <div class="table-container">
    <table class="jornada-table">
      <thead>
        <tr>
          <th data-i18n="number">{t.number}</th>
          <th data-i18n="player">{t.player}</th>
          <th data-i18n="minutes">{t.minutes}</th>
          <th data-i18n="points">{t.points}</th>
          <th data-i18n="t2">{t.t2}</th>
          <th data-i18n="t3">{t.t3}</th>
          <th data-i18n="freeThrowsMade">{t.freeThrowsMade}</th>
          <th data-i18n="freeThrowsAttempted">{t.freeThrowsAttempted}</th>
          <th data-i18n="assists">{t.assists}</th>
          <th data-i18n="rebounds">{t.rebounds}</th>
          <th data-i18n="steals">{t.steals}</th>
          <th data-i18n="turnovers">{t.turnovers}</th>
          <th data-i18n="fouls">{t.fouls}</th>
          <th data-i18n="rating">{t.rating}</th>
        </tr>
      </thead>
      <tbody>
        {players.map((player) => (
          <tr>
            <td>{player.number}</td>
            <td>
                {player.number === mvpNumber && <span class="mvp-crown-table">👑</span>}
                {player.name}
              </td>
            <td>{player.minutes}</td>
            <td>{player.points}</td>
            <td>{player.t2}</td>
            <td>{player.t3}</td>
            <td>{player.ftMade}</td>
            <td>{player.ftAtt}</td>
            <td>{player.assists}</td>
            <td>{player.rebounds}</td>
            <td>{player.steals}</td>
            <td>{player.turnovers}</td>
            <td>{player.fouls}</td>
            <td>{player.valuation}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="mobile-cards">
      {players.map((player) => (
        <div class="player-card">
          <div class="player-name">
              {player.number === mvpNumber && <div class="mvp-crown-top">👑</div>}
              {player.name} <span class="player-number">{player.number}</span>
            </div>
          <div class="stats-grid">
            <div class="stat-item">
              <span class="stat-label" data-i18n="minutesLabel">{t.minutesLabel}</span>
              <span class="stat-value">{player.minutes}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="pointsLabel">{t.pointsLabel}</span>
              <span class="stat-value">{player.points}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="ratingLabel">{t.ratingLabel}</span>
              <span class="stat-value">{player.valuation}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="t2">{t.t2}:</span>
              <span class="stat-value">{player.t2}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="t3">{t.t3}:</span>
              <span class="stat-value">{player.t3}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="freeThrows">{t.freeThrows}</span>
              <span class="stat-value">{player.ftMade}/{player.ftAtt}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="assistsLabel">{t.assistsLabel}</span>
              <span class="stat-value">{player.assists}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="reboundsLabel">{t.reboundsLabel}</span>
              <span class="stat-value">{player.rebounds}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="stealsLabel">{t.stealsLabel}</span>
              <span class="stat-value">{player.steals}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="turnoversLabel">{t.turnoversLabel}</span>
              <span class="stat-value">{player.turnovers}</span>
            </div>
            <div class="stat-item">
              <span class="stat-label" data-i18n="foulsLabel">{t.foulsLabel}</span>
              <span class="stat-value">{player.fouls}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</JornadaPost>

<script>
  import { initJornadaLanguageSync } from '../../scripts/jornadaLanguageSync';
  initJornadaLanguageSync();
</script>