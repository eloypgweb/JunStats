---
import JornadaPost from '../../layouts/JornadaPost.astro';
import '../../styles/jornadas-shared.css';
// i18n
import { getTranslations } from '../../i18n/translations';
const t = getTranslations('es').jornadas;

function formatMinutes(value: string | undefined): string {
  if (!value) return '00:00';
  const [minutes = '00', seconds = '00'] = value.split(':');
  return `${minutes.padStart(2, '0')}:${seconds.padStart(2, '0')}`;
}

const players = [
  { number: 1, name: 'Hugo Arias', minutes: '', points: 8, t2: 2, t3: 1, ftMade: 1, ftAtt: 4, assists: 1, rebounds: 9, steals: 3, turnovers: 2, fouls: 4 },
  { number: 8, name: 'Sergio Redondo', minutes: '', points: 3, t2: 1, t3: 0, ftMade: 1, ftAtt: 2, assists: 1, rebounds: 2, steals: 0, turnovers: 1, fouls: 1 },
  { number: 12, name: 'Pablo Fernández', minutes: '', points: 2, t2: 1, t3: 0, ftMade: 0, ftAtt: 0, assists: 1, rebounds: 2, steals: 1, turnovers: 1, fouls: 3 },
  { number: 13, name: 'Tristán Redondo', minutes: '', points: 7, t2: 3, t3: 0, ftMade: 1, ftAtt: 4, assists: 2, rebounds: 2, steals: 1, turnovers: 2, fouls: 3 },
  { number: 15, name: 'Uyi', minutes: '', points: 3, t2: 1, t3: 0, ftMade: 1, ftAtt: 2, assists: 1, rebounds: 6, steals: 1, turnovers: 2, fouls: 4 },
  { number: 16, name: 'David Ortega', minutes: '', points: 2, t2: 1, t3: 0, ftMade: 0, ftAtt: 0, assists: 1, rebounds: 4, steals: 3, turnovers: 0, fouls: 2 },
  { number: 17, name: 'Álvaro Zamorano', minutes: '', points: 14, t2: 5, t3: 0, ftMade: 4, ftAtt: 7, assists: 2, rebounds: 1, steals: 3, turnovers: 2, fouls: 5 },
  { number: 20, name: 'Daniel Chamizo', minutes: '', points: 2, t2: 1, t3: 0, ftMade: 0, ftAtt: 0, assists: 2, rebounds: 0, steals: 1, turnovers: 0, fouls: 5 },
  { number: 30, name: 'Álvaro Fernández', minutes: '', points: 8, t2: 4, t3: 0, ftMade: 0, ftAtt: 0, assists: 5, rebounds: 8, steals: 2, turnovers: 5, fouls: 1 },
  { number: 33, name: 'Roberto García', minutes: '', points: 0, t2: 0, t3: 0, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 0, isAbsent: true },
  { number: 56, name: 'Víctor Guardeño', minutes: '', points: 3, t2: 1, t3: 0, ftMade: 1, ftAtt: 2, assists: 0, rebounds: 5, steals: 2, turnovers: 4, fouls: 3 },
  { number: 91, name: 'Rodrigo Díaz', minutes: '', points: 8, t2: 3, t3: 0, ftMade: 2, ftAtt: 4, assists: 1, rebounds: 5, steals: 2, turnovers: 1, fouls: 3 }
];

const mvpNumber = 17;
---

<JornadaPost 
  title="Jornada 4"
  description="Resumen de la cuarta jornada de la temporada."
  pubDate={new Date('2025-10-11')}
>
  <div class="match-info">
    <h3><span data-i18n="vs">{t.vs}</span> Distrito Carabanchel</h3>

    <div class="match-result defeat">
      <div class="score-container">
        <span class="team-score opponent winner">57</span>
        <span class="score-separator">-</span>
        <span class="team-score home">76</span>
      </div>

      <div class="result-badge">
        <span class="badge-icon">😔</span>
        <span class="badge-text" data-i18n="defeat">{t.defeat}</span>
      </div>
    </div>
  </div>

  <div class="table-container">
    <table class="jornada-table">
      <thead>
        <tr>
          <th data-i18n="number">{t.number}</th>
          <th data-i18n="player">{t.player}</th>
          <th data-i18n="minutes">{t.minutes}</th>
          <th data-i18n="points">{t.points}</th>
          <th data-i18n="t2">{t.t2}</th>
          <th data-i18n="t3">{t.t3}</th>
          <th data-i18n="freeThrowsMade">{t.freeThrowsMade}</th>
          <th data-i18n="freeThrowsAttempted">{t.freeThrowsAttempted}</th>
          <th data-i18n="assists">{t.assists}</th>
          <th data-i18n="rebounds">{t.rebounds}</th>
          <th data-i18n="steals">{t.steals}</th>
          <th data-i18n="turnovers">{t.turnovers}</th>
          <th data-i18n="fouls">{t.fouls}</th>
        </tr>
      </thead>

      <tbody>
        {players.map((player) => (
          player.isAbsent ? (
            <tr class="ausente-row">
              <td>{player.number}</td>
              <td>{player.name}</td>
              <td colspan="11" class="ausente-cell">
                <span class="ausente-badge" data-i18n="absent">{t.absent}</span>
              </td>
            </tr>
          ) : (
            <tr>
              <td>{player.number}</td>
              <td>
                {player.number === mvpNumber && <span class="mvp-crown-table">👑</span>}
                {player.name}
              </td>
              <td>{formatMinutes(player.minutes)}</td>
              <td>{player.points}</td>
              <td>{player.t2}</td>
              <td>{player.t3}</td>
              <td>{player.ftMade}</td>
              <td>{player.ftAtt}</td>
              <td>{player.assists}</td>
              <td>{player.rebounds}</td>
              <td>{player.steals}</td>
              <td>{player.turnovers}</td>
              <td>{player.fouls}</td>
            </tr>
          )
        ))}
      </tbody>
    </table>

    <div class="mobile-cards">
      {players.map((player) => (
        player.isAbsent ? (
          <div class="player-card ausente-card">
            <div class="player-name">
              {player.name} <span class="player-number">{player.number}</span>
            </div>
            <div class="stats-grid ausente-mobile">
              <span class="ausente-badge" data-i18n="absent">{t.absent}</span>
            </div>
          </div>
        ) : (
          <div class="player-card">
            <div class="player-name">
              {player.number === mvpNumber && <div class="mvp-crown-top">👑</div>}
              {player.name} <span class="player-number">{player.number}</span>
            </div>

            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-label">{t.pointsLabel}</span>
                <span class="stat-value">{player.points}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.minutesLabel}</span>
                <span class="stat-value">{formatMinutes(player.minutes)}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.t2}:</span>
                <span class="stat-value">{player.t2}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.t3}:</span>
                <span class="stat-value">{player.t3}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.freeThrows}</span>
                <span class="stat-value">{player.ftMade}/{player.ftAtt}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.assistsLabel}</span>
                <span class="stat-value">{player.assists}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.reboundsLabel}</span>
                <span class="stat-value">{player.rebounds}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.stealsLabel}</span>
                <span class="stat-value">{player.steals}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.turnoversLabel}</span>
                <span class="stat-value">{player.turnovers}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.foulsLabel}</span>
                <span class="stat-value">{player.fouls}</span>
              </div>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</JornadaPost>

<script>
  import { initJornadaLanguageSync } from '../../scripts/jornadaLanguageSync';
  initJornadaLanguageSync();
</script>