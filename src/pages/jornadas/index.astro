---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import totaltemporada from '../../assets/totaltemporada.png';
import promediostemporada from '../../assets/promediostemporada.png';
import jornadas from '../../data/jornadas.json';
import '../../styles/jornadas-index.css';

// i18n
import { getTranslations } from '../../i18n/translations';
const t = getTranslations('es').jornadas;

// Importar las imágenes dinámicamente
import presJ1 from '../../assets/jornadas/presJ1.webp';
import presJ2 from '../../assets/jornadas/presJ2.webp';
import presJ3 from '../../assets/jornadas/presJ3.webp';
import presJ4 from '../../assets/jornadas/presJ4.webp';
import presJ5 from '../../assets/jornadas/presJ5.webp';
import presJ6 from '../../assets/jornadas/presJ6.webp';
import presJ7 from '../../assets/jornadas/presJ7.webp';
import presJ8 from '../../assets/jornadas/presJ8.webp';
import presJ9 from '../../assets/jornadas/presJ9.webp';
import presJ10 from '../../assets/jornadas/presJ10.webp';
import presJ12 from '../../assets/jornadas/presJ12.webp';
import presJ13 from '../../assets/jornadas/presJ13.webp';
import presJ14 from '../../assets/jornadas/presJ14.webp';
import presJ15 from '../../assets/jornadas/presJ15.webp';
import presJ16 from '../../assets/jornadas/presJ16.webp';
import presJ17 from '../../assets/jornadas/presJ17.webp';
import presJ18 from '../../assets/jornadas/presJ18.webp';
import presJ19 from '../../assets/jornadas/presJ19.webp';
import presJ20 from '../../assets/jornadas/presJ20.webp';
import presJ21 from '../../assets/jornadas/presJ21.webp';
import presJ22 from '../../assets/jornadas/presJ22.webp';
import presJ23 from '../../assets/jornadas/presJ23.webp';
import presJ24 from '../../assets/jornadas/presJ24.webp';
import presJ21Epic from '../../assets/jornadas/epic/presJ21Epic.webp';
import presJ22Epic from '../../assets/jornadas/epic/presJ22EpicZamo.webp';
import presJ23Epic from '../../assets/jornadas/epic/presJ23Epic.webp';
import presJ24Epic from '../../assets/jornadas/epic/presJ24Epic.webp';
import presJ25EpicNoOne from '../../assets/jornadas/epic/presJ25EpicNoOne.webp';

// Mapear las imágenes
// Ahora mismo hay 1-9; +j21, j22, j23; falta j10-j20.
const imageMap: Record<string, any> = {
	'/src/assets/jornadas/presJ1.webp': presJ1,
	'/src/assets/jornadas/presJ2.webp': presJ2,
    '/src/assets/jornadas/presJ3.webp': presJ3,
    '/src/assets/jornadas/presJ4.webp': presJ4,
    '/src/assets/jornadas/presJ5.webp': presJ5,
    '/src/assets/jornadas/presJ6.webp': presJ6,
    '/src/assets/jornadas/presJ7.webp': presJ7,
	'/src/assets/jornadas/presJ8.webp': presJ8,
	'/src/assets/jornadas/presJ9.webp': presJ9,
	'/src/assets/jornadas/presJ10.webp': presJ10,
	'/src/assets/jornadas/presJ12.webp': presJ12,
	'/src/assets/jornadas/presJ13.webp': presJ13,
	'/src/assets/jornadas/presJ14.webp': presJ14,
	'/src/assets/jornadas/presJ15.webp': presJ15,
	'/src/assets/jornadas/presJ16.webp': presJ16,
	'/src/assets/jornadas/presJ17.webp': presJ17,
	'/src/assets/jornadas/presJ18.webp': presJ18,
	'/src/assets/jornadas/presJ19.webp': presJ19,
	'/src/assets/jornadas/presJ20.webp': presJ20,
	'/src/assets/jornadas/presJ21.webp': presJ21,
	'/src/assets/jornadas/presJ22.webp': presJ22,
	'/src/assets/jornadas/presJ23.webp': presJ23,
	'/src/assets/jornadas/presJ24.webp': presJ24,
	'/src/assets/jornadas/epic/presJ21Epic.webp': presJ21Epic,
	'/src/assets/jornadas/epic/presJ22EpicZamo.webp': presJ22Epic,
	'/src/assets/jornadas/epic/presJ23Epic.webp': presJ23Epic,
	'/src/assets/jornadas/epic/presJ24Epic.webp': presJ24Epic,
	'/src/assets/jornadas/epic/presJ25EpicNoOne.webp': presJ25EpicNoOne,
};

// Ordenar jornadas por fecha (más recientes primero)
const sortedJornadas = jornadas
	.map(jornada => ({
		...jornada,
		pubDate: new Date(jornada.pubDate),
		heroImage: imageMap[jornada.heroImage]
	}))
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- <h2>Estadísticas de la temporada:</h2> -->
			<section>
				<ul>
					{
						sortedJornadas.map((jornada, index) => (
							<li class={!jornada.available ? 'jornada-unavailable' : ''}>
								{jornada.available ? (
									<a href={`/jornadas/${jornada.slug}/`}>
										{jornada.heroImage && (
											<div class="jornada-thumb">
												<Image
													src={jornada.heroImage}
													alt=""
													width={index === 0 ? 1200 : 720}
													height={index === 0 ? 600 : 360}
													widths={index === 0 ? [720, 960, 1200, 1600] : [360, 540, 720, 960]}
													sizes={index === 0 ? '(max-width: 720px) 100vw, 960px' : '(max-width: 720px) 100vw, 480px'}
													quality={95}
												/>
											</div>
										)}
										<div class="content">
											<h4 class="title">{jornada.title}</h4>
											<p class="date">
												<FormattedDate date={jornada.pubDate} />
											</p>
										</div>
									</a>
								) : (
									<div>
										{jornada.heroImage && (
											<div class="jornada-thumb">
												<Image
													src={jornada.heroImage}
													alt=""
													width={index === 0 ? 1200 : 720}
													height={index === 0 ? 600 : 360}
													widths={index === 0 ? [720, 960, 1200, 1600] : [360, 540, 720, 960]}
													sizes={index === 0 ? '(max-width: 720px) 100vw, 960px' : '(max-width: 720px) 100vw, 480px'}
													quality={95}
												/>
											</div>
										)}
										<div class="content">
											<h4 class="title">{jornada.title}</h4>
											<p class="date">
												<FormattedDate date={jornada.pubDate} />
											</p>
										</div>
										<div class="coming-soon-badge">
											<span data-i18n="comingSoon">{t.comingSoon}</span>
											<p style="margin-bottom: 0.2%; margin-top: 0.2%">🕓 <span>{jornada.time}</span></p>
										</div>
									</div>
								)}
							</li>
						))
					}
				</ul>
				<!--
				<div class="table">
					<h3 class="table-title">Tabla total de temporada</h3>
					<img src={totaltemporada.src} alt="tabla de estadísticas totales de temporada" class="table-img"/>
				</div>
				<div class="table">
					<h3 class="table-title">Tabla promedios de temporada</h3>
					<img src={promediostemporada.src} alt="tabla de estadísticas promedios de temporada" class="table-img"/>
				</div>
				-->
			</section>
		</main>
		<Footer />
		
		<script>
			import { translations } from '../../i18n/translations';
			import type { Language } from '../../i18n/translations';
			
			function updatePageLanguage(lang: Language) {
				const t = translations[lang].jornadas;
				
				// Actualizar todos los elementos con data-i18n
				document.querySelectorAll('[data-i18n]').forEach(element => {
					const key = element.getAttribute('data-i18n') as keyof typeof t;
					if (key && t[key]) {
						const translation = t[key] as string;
						element.textContent = translation;
					}
				});
			}
			
			function initLanguageSync() {
				const currentLang = (document.documentElement.getAttribute('data-language') || 'es') as Language;
				updatePageLanguage(currentLang);
				
				document.addEventListener('click', (e) => {
					const target = e.target as HTMLElement;
					const button = target.closest('.language-toggle-btn');
					
					if (button) {
						setTimeout(() => {
							const newLang = (document.documentElement.getAttribute('data-language') || 'es') as Language;
							updatePageLanguage(newLang);
						}, 50);
					}
				});
			}
			
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initLanguageSync);
			} else {
				initLanguageSync();
			}
			
			document.addEventListener('astro:page-load', initLanguageSync);
		</script>
	</body>
</html>
