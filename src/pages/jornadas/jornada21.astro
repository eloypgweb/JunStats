---
import JornadaPost from '../../layouts/JornadaPost.astro';
import '../../styles/jornadas-shared.css';
// i18n
import { getTranslations } from '../../i18n/translations';
const t = getTranslations('es').jornadas;

const players = [
  { number: 1, name: 'Hugo Arias', points: 5, t2: 1, t3: 1, ftMade: 0, ftAtt: 2, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 3, valuation: 0 },
  { number: 8, name: 'Sergio Redondo', points: 5, t2: 1, t3: 1, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 1, valuation: 4 },
  { number: 12, name: 'Pablo Fernández', points: 2, t2: 1, t3: 0, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 1, valuation: 1 },
  { number: 13, name: 'Tristán Redondo', points: 4, t2: 1, t3: 0, ftMade: 2, ftAtt: 5, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 0, valuation: 1 },
  { number: 15, name: 'Uyi', points: 9, t2: 1, t3: 2, ftMade: 1, ftAtt: 2, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 2, valuation: 6 },
  { number: 16, name: 'David Ortega', points: 4, t2: 2, t3: 0, ftMade: 0, ftAtt: 2, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 1, valuation: 1 },
  { number: 17, name: 'Álvaro Zamorano', points: 10, t2: 2, t3: 2, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 0, valuation: 6 },
  { number: 20, name: 'Daniel Chamizo', points: 4, t2: 2, t3: 0, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 1, valuation: 3 },
  { number: 30, name: 'Álvaro Fernández', points: 3, t2: 0, t3: 1, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 3, valuation: 0 },
  { number: 33, name: 'Roberto García', points: 0, t2: 0, t3: 0, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 0, valuation: 0, isAbsent: true },
  { number: 56, name: 'Víctor Guardeño', points: 2, t2: 1, t3: 0, ftMade: 0, ftAtt: 0, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 1, valuation: 1 },
  { number: 91, name: 'Rodrigo Díaz', points: 8, t2: 4, t3: 0, ftMade: 0, ftAtt: 2, assists: 0, rebounds: 0, steals: 0, turnovers: 0, fouls: 0, valuation: 6 }
];

const mvpNumber = 17;
---

<JornadaPost 
  title="Jornada 21"
  description="Resumen de la jornada 21 de la temporada."
  pubDate={new Date('2026-03-15')}
>
  <div class="match-info">
    <h3><span data-i18n="vs">{t.vs}</span> San Blas Basket</h3>
    <div class="match-result defeat">
      <div class="score-container">
        <span class="team-score opponent winner">79</span>
        <span class="score-separator">-</span>
        <span class="team-score home">56</span>
      </div>
      <div class="result-badge">
        <span class="badge-icon">😔</span>
        <span class="badge-text" data-i18n="defeat">{t.defeat}</span>
      </div>
    </div>
  </div>

  <div class="table-container">
    <table class="jornada-table">
      <thead>
        <tr>
          <th data-i18n="number">{t.number}</th>
          <th data-i18n="player">{t.player}</th>
          <th data-i18n="points">{t.points}</th>
          <th data-i18n="t2">{t.t2}</th>
          <th data-i18n="t3">{t.t3}</th>
          <th data-i18n="freeThrowsMade">{t.freeThrowsMade}</th>
          <th data-i18n="freeThrowsAttempted">{t.freeThrowsAttempted}</th>
          <th data-i18n="assists">{t.assists}</th>
          <th data-i18n="rebounds">{t.rebounds}</th>
          <th data-i18n="steals">{t.steals}</th>
          <th data-i18n="turnovers">{t.turnovers}</th>
          <th data-i18n="fouls">{t.fouls}</th>
          <th data-i18n="rating">{t.rating}</th>
        </tr>
      </thead>
      <tbody>
        {players.map((player) => (
          player.isAbsent ? (
            <tr class="ausente-row">
              <td>{player.number}</td>
              <td>{player.name}</td>
              <td colspan="11" class="ausente-cell">
                <span class="ausente-badge" data-i18n="absent">{t.absent}</span>
              </td>
            </tr>
          ) : (
            <tr>
              <td>{player.number}</td>
              <td>
                {player.number === mvpNumber && <span class="mvp-crown-table">👑</span>}
                {player.name}
              </td>
              <td>{player.points}</td>
              <td>{player.t2}</td>
              <td>{player.t3}</td>
              <td>{player.ftMade}</td>
              <td>{player.ftAtt}</td>
              <td>{player.assists}</td>
              <td>{player.rebounds}</td>
              <td>{player.steals}</td>
              <td>{player.turnovers}</td>
              <td>{player.fouls}</td>
              <td>{player.valuation}</td>
            </tr>
          )
        ))}
      </tbody>
    </table>

    <div class="mobile-cards">
      {players.map((player) => (
        player.isAbsent ? (
          <div class="player-card ausente-card">
            <div class="player-name">
              {player.name} <span class="player-number">{player.number}</span>
            </div>
            <div class="stats-grid ausente-mobile">
              <span class="ausente-badge" data-i18n="absent">{t.absent}</span>
            </div>
          </div>
        ) : (
          <div class="player-card">
            <div class="player-name">
              {player.number === mvpNumber && <div class="mvp-crown-top">👑</div>}
              {player.name} <span class="player-number">{player.number}</span>
            </div>
            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-label" data-i18n="pointsLabel">{t.pointsLabel}</span>
                <span class="stat-value">{player.points}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="ratingLabel">{t.ratingLabel}</span>
                <span class="stat-value">{player.valuation}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="t2">{t.t2}:</span>
                <span class="stat-value">{player.t2}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="t3">{t.t3}:</span>
                <span class="stat-value">{player.t3}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="freeThrows">{t.freeThrows}</span>
                <span class="stat-value">{player.ftMade}/{player.ftAtt}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="assistsLabel">{t.assistsLabel}</span>
                <span class="stat-value">{player.assists}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="reboundsLabel">{t.reboundsLabel}</span>
                <span class="stat-value">{player.rebounds}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="stealsLabel">{t.stealsLabel}</span>
                <span class="stat-value">{player.steals}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="turnoversLabel">{t.turnoversLabel}</span>
                <span class="stat-value">{player.turnovers}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label" data-i18n="foulsLabel">{t.foulsLabel}</span>
                <span class="stat-value">{player.fouls}</span>
              </div>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</JornadaPost>

<script>
  import { initJornadaLanguageSync } from '../../scripts/jornadaLanguageSync';
  initJornadaLanguageSync();
</script>
