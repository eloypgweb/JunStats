---
import JornadaPost from '../../layouts/JornadaPost.astro';
import '../../styles/jornadas-shared.css';
// i18n
import { getTranslations } from '../../i18n/translations';
const t = getTranslations('es').jornadas;

function formatMinutes(value: string | undefined): string {
  if (!value) return '00:00';
  const [minutes = '00', seconds = '00'] = value.split(':');
  return `${minutes.padStart(2, '0')}:${seconds.padStart(2, '0')}`;
}

const players = [
  { number: 1, name: 'Hugo Arias', isSancionado: true },

  { number: 8, name: 'Sergio Redondo', minutes: '', points: 2, t2: 1, t3: 0, ft: '0/0', assists: 1, rebounds: 1, steals: 0, turnovers: 4, fouls: 0 },
  { number: 12, name: 'Pablo Fernández', minutes: '', points: 4, t2: 2, t3: 0, ft: '0/0', assists: 2, rebounds: 2, steals: 0, turnovers: 0, fouls: 1 },
  { number: 13, name: 'Tristán Redondo', minutes: '', points: 4, t2: 0, t3: 0, ft: '4/5', assists: 0, rebounds: 1, steals: 3, turnovers: 5, fouls: 2 },
  { number: 15, name: 'Uyi', minutes: '', points: 2, t2: 1, t3: 0, ft: '0/2', assists: 0, rebounds: 3, steals: 4, turnovers: 4, fouls: 4 },
  { number: 16, name: 'David Ortega', minutes: '', points: 8, t2: 4, t3: 0, ft: '0/0', assists: 0, rebounds: 0, steals: 2, turnovers: 1, fouls: 3 },
  { number: 17, name: 'Álvaro Zamorano', minutes: '', points: 6, t2: 0, t3: 2, ft: '0/0', assists: 1, rebounds: 2, steals: 2, turnovers: 1, fouls: 1 },
  { number: 20, name: 'Daniel Chamizo', minutes: '', points: 2, t2: 1, t3: 0, ft: '0/0', assists: 1, rebounds: 2, steals: 0, turnovers: 3, fouls: 4 },
  { number: 30, name: 'Álvaro Fernández', minutes: '', points: 3, t2: 1, t3: 0, ft: '1/3', assists: 0, rebounds: 2, steals: 0, turnovers: 1, fouls: 4 },
  { number: 33, name: 'Roberto García', minutes: '', points: 2, t2: 1, t3: 0, ft: '2/6', assists: 0, rebounds: 0, steals: 2, turnovers: 2, fouls: 3 },
  { number: 56, name: 'Víctor Guardeño', minutes: '', points: 4, t2: 2, t3: 0, ft: '0/2', assists: 0, rebounds: 5, steals: 0, turnovers: 3, fouls: 3 },
  { number: 91, name: 'Rodrigo Díaz', minutes: '', points: 8, t2: 4, t3: 0, ft: '0/0', assists: 0, rebounds: 3, steals: 1, turnovers: 0, fouls: 2 }
];

const mvpNumber = 91;
---

<JornadaPost 
  title="Jornada 6"
  description="Resumen de la sexta jornada de la temporada."
  pubDate={new Date('2025-10-25')}
>
  <div class="match-info">
    <h3><span data-i18n="vs">{t.vs}</span> Club Europeo Baloncesto</h3>

    <div class="match-result defeat">
      <div class="score-container">
        <span class="team-score home">45</span>
        <span class="score-separator">-</span>
        <span class="team-score opponent winner">84</span>
      </div>

      <div class="result-badge">
        <span class="badge-icon">😔</span>
        <span class="badge-text" data-i18n="defeat">{t.defeat}</span>
      </div>
    </div>
  </div>

  <div class="table-container">
    <table class="jornada-table">
      <thead>
        <tr>
          <th data-i18n="number">{t.number}</th>
          <th data-i18n="player">{t.player}</th>
          <th data-i18n="minutes">{t.minutes}</th>
          <th data-i18n="points">{t.points}</th>
          <th data-i18n="t2">{t.t2}</th>
          <th data-i18n="t3">{t.t3}</th>
          <th data-i18n="freeThrows">{t.freeThrows}</th>
          <th data-i18n="assists">{t.assists}</th>
          <th data-i18n="rebounds">{t.rebounds}</th>
          <th data-i18n="steals">{t.steals}</th>
          <th data-i18n="turnovers">{t.turnovers}</th>
          <th data-i18n="fouls">{t.fouls}</th>
        </tr>
      </thead>

      <tbody>
        {players.map((player) =>
          player.isSancionado ? (
            <tr class="sancionado-row">
              <td>{player.number}</td>
              <td>{player.name}</td>
              <td colspan="11" class="sancionado-cell">
                <span class="sancionado-badge" data-i18n="sancionado">{t.sancionado}</span>
              </td>
            </tr>
          ) : (
            <tr>
              <td>{player.number}</td>
              <td>
                {player.number === mvpNumber && <span class="mvp-crown-table">👑</span>}
                {player.name}
              </td>
              <td>{formatMinutes(player.minutes)}</td>
              <td>{player.points}</td>
              <td>{player.t2}</td>
              <td>{player.t3}</td>
              <td>{player.ft}</td>
              <td>{player.assists}</td>
              <td>{player.rebounds}</td>
              <td>{player.steals}</td>
              <td>{player.turnovers}</td>
              <td>{player.fouls}</td>
            </tr>
          )
        )}
      </tbody>
    </table>

    <div class="mobile-cards">
      {players.map((player) =>
        player.isSancionado ? (
          <div class="player-card sancionado-card">
            <div class="player-name">
              {player.name} <span class="player-number">{player.number}</span>
            </div>
            <div class="stats-grid sancionado-mobile">
              <span class="sancionado-badge" data-i18n="sancionado">{t.sancionado}</span>
            </div>
          </div>
        ) : (
          <div class="player-card">
            <div class="player-name">
              {player.number === mvpNumber && <div class="mvp-crown-top">👑</div>}
              {player.name} <span class="player-number">{player.number}</span>
            </div>

            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-label">{t.pointsLabel}</span>
                <span class="stat-value">{player.points}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.minutesLabel}</span>
                <span class="stat-value">{formatMinutes(player.minutes)}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.t2}:</span>
                <span class="stat-value">{player.t2}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.t3}:</span>
                <span class="stat-value">{player.t3}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.freeThrows}</span>
                <span class="stat-value">{player.ft}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.assistsLabel}</span>
                <span class="stat-value">{player.assists}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.reboundsLabel}</span>
                <span class="stat-value">{player.rebounds}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.stealsLabel}</span>
                <span class="stat-value">{player.steals}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.turnoversLabel}</span>
                <span class="stat-value">{player.turnovers}</span>
              </div>

              <div class="stat-item">
                <span class="stat-label">{t.foulsLabel}</span>
                <span class="stat-value">{player.fouls}</span>
              </div>
            </div>
          </div>
        )
      )}
    </div>
  </div>
</JornadaPost>

<script>
  import { initJornadaLanguageSync } from '../../scripts/jornadaLanguageSync';
  initJornadaLanguageSync();
</script>